{
  "expo": {
    "name": "Flashcard Library",
    "slug": "flashcardlibrary",
    "version": "0.5.1",
    "orientation": "portrait",
    "icon": "./assets/adaptive-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.opensorcerer20.flashcardlibrary",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": {
        "dark": "./assets/ios-dark.png",
        "light": "./assets/ios-light.png",
        "tinted": "./assets/ios-tinted.png"
      }
    },
    "android": {
      "package": "com.opensorcerer20.flashcardlibrary",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121212"
      },
      "softwareKeyboardLayoutMode": "pan"
    },
    "owner": "opensorcerer20",
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7a960274-0ed7-421e-bf44-53940aadcc5f"
      }
    },
    "scheme": [
      "com.opensorcerer20.flashcardlibrary"
    ]
  }
}
