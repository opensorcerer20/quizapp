{
  "expo": {
    "name": "Flashcard Library",
    "slug": "flashcardlibrary",
    "version": "0.7.0",
    "orientation": "portrait",
    "icon": "./assets/adaptive-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cocoadroidllc.flashcardlibrary",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/ios-light.png"
    },
    "android": {
      "package": "com.cocoadroidllc.flashcardlibrary",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121212"
      },
      "softwareKeyboardLayoutMode": "pan"
    },
    "owner": "opensorcerer20",
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "minSdkVersion": 32
          },
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7a960274-0ed7-421e-bf44-53940aadcc5f"
      }
    },
    "scheme": [
      "com.cocoadroidllc.flashcardlibrary"
    ]
  }
}